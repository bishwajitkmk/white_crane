# Comments must be on their own line: an empty value followed by "# ..." is read as the comment text.

DATABASE_URL=postgresql+psycopg://wc:wc@localhost:5432/whitecrane
# No Docker? SQLite works for local development:
# DATABASE_URL=sqlite:///./dev.db

# Long random string in every real environment: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
# Extra allowed CORS origins, comma separated (vite preview, PR preview deploys)
CORS_ORIGINS=http://localhost:4173

# Production: COOKIE_SECURE=true. Use COOKIE_SAMESITE=none only if the site and API are on
# different registrable domains (e.g. *.vercel.app + *.up.railway.app); keep lax for whitecrane.org + api.whitecrane.org.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# resend | postmark | mailpit | console (console just logs emails; mailpit needs docker compose, inbox at :8025)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=info@whitecrane.org
RESEND_API_KEY=
POSTMARK_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=1025

# Cloudflare R2 (S3-compatible). Leave S3_ENDPOINT empty in development: uploads are then stored in
# LOCAL_UPLOAD_DIR and served by the API at /files/.
S3_ENDPOINT=
S3_BUCKET=whitecrane
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public bucket URL used for stored file links
S3_PUBLIC_URL=
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
